# Backend provider credentials (fill in locally; never commit real secrets)
GROQ_API_KEY=
GROQ_API_KEY_2=
COHERE_API_KEY=
TAVILY_API_KEY=

# Google Identity Services / API authentication
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=

# Model profile overrides (optional; defaults are defined in src/backend/llm/profiles.py)
MODEL_FAST=openai/gpt-oss-20b
MODEL_REASONING=openai/gpt-oss-120b
MODEL_SAFETY=openai/gpt-oss-safeguard-20b

# Local infrastructure
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgresql://mathtutor:mathtutor@localhost:5432/mathtutor

# FastAPI
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
ALLOWED_ORIGINS=http://localhost:3000

# Optional OCR credential path, if the corresponding OCR flow is enabled
GOOGLE_APPLICATION_CREDENTIALS=./secrets/google-credentials.json
