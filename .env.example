# V2 provider: groq | openrouter | openai | anthropic | ollama | custom
LLM_PROVIDER=groq
LLM_FAST_MODEL=openai/gpt-oss-20b
LLM_REASONING_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
LLM_MAX_RETRIES=2
# Optional OpenAI-compatible endpoint (OpenRouter/custom/Ollama)
LLM_BASE_URL=

GROQ_API_KEY=
GROQ_API_KEY_2=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_API_KEY=

COHERE_API_KEY=
TAVILY_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
REDIS_URL=redis://localhost:6379
OAUTH_REDIRECT_URI=http://localhost:8501/oauth2callback
GOOGLE_APPLICATION_CREDENTIALS=
