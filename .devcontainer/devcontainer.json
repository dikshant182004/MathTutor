{
  "name": "MathTutor (FastAPI + Next.js)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.14-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "Readme.md",
        "src/frontend/app/page.tsx"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "dbaeumer.vscode-eslint"
      ]
    }
  },
  "updateContentCommand": "python -m pip install -r requirements-api.txt -r requirements-test.txt && npm --prefix src/frontend install",
  "postAttachCommand": {
    "frontend": "cd src/frontend && npm run dev"
  },
  "portsAttributes": {
    "3000": {
      "label": "MathTutor frontend",
      "onAutoForward": "openPreview"
    },
    "8000": {
      "label": "MathTutor API",
      "onAutoForward": "silent"
    }
  },
  "forwardPorts": [
    3000,
    8000
  ]
}
